{
  "info": {
    "name": "Datatouille IMAP Spam Detection API",
    "description": "Requests of every endpoint of the IMAP Spam Detection API, in the order of the test sequence of the README.\n\nBefore running it, open the collection, go to the **Variables** tab and set `baseUrl` (`http://127.0.0.1:8000` locally or `https://datatouille-api.onrender.com`) and `adminKey` (the value of `ADMIN_API_KEY`). The variables `A`, `B`, `C`, `F` and `G` are filled in automatically.\n\nThe requests create rows in the database and the *Cleanup* folder deletes them at the end.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. General",
      "description": "Public endpoints that do not touch the database.",
      "item": [
        {
          "name": "1. Welcome",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Returns the API version\", function () { pm.expect(pm.response.json()).to.have.property(\"version\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Model is loaded\", function () { pm.expect(pm.response.json().model_loaded).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Production model",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/model",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "model"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Returns the model metrics\", function () { pm.expect(pm.response.json()).to.have.property(\"metrics\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Public endpoints",
      "description": "Classification, summarization and feedback. They do not need the X-API-Key header.",
      "item": [
        {
          "name": "4. Predict (creates 2 predictions, saves A and B)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/predict",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "predict"
              ]
            },
            "description": "Stores two rows in the `predictions` table. Their identifiers are saved in the collection variables `A` and `B`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"texts\": [\n    \"WIN a FREE iPhone now!!! Claim at http://win.example\",\n    \"Hi team, the meeting is on Monday. Write to ana@example.com\"\n  ],\n  \"threshold\": 0.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const predictions = pm.response.json().predictions;",
                  "pm.test(\"Returns two predictions\", function () { pm.expect(predictions.length).to.eql(2); });",
                  "pm.collectionVariables.set(\"A\", predictions[0].prediction_id);",
                  "pm.collectionVariables.set(\"B\", predictions[1].prediction_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Summarize",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/summarize",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "summarize"
              ]
            },
            "description": "Requires `GEMINI_API_KEY` or `CLOUD_SUMMARIZATION_URL` on the server; otherwise it returns 502.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Hi team, the project meeting has been moved to Monday at 10. Please bring the report.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Returns a summary\", function () { pm.expect(pm.response.json().summary).to.be.a(\"string\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Create feedback for A (saves F)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/feedback",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "feedback"
              ]
            },
            "description": "Stores one row in the `feedback` table. Its identifier is saved in the collection variable `F`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prediction_id\": {{A}},\n  \"corrected_label\": \"not_spam\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Corrected label is stored\", function () { pm.expect(pm.response.json().corrected_label).to.eql(\"not_spam\"); });",
                  "pm.collectionVariables.set(\"F\", pm.response.json().id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Admin: predictions",
      "description": "CRUD of the `predictions` table. Every request sends the header `X-API-Key: {{adminKey}}`.",
      "item": [
        {
          "name": "7. List predictions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{adminKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/predictions?limit=100&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "predictions"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "100"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Includes prediction A\", function () { pm.expect(pm.response.json().map(r => r.id)).to.include(Number(pm.collectionVariables.get(\"A\"))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Get prediction B",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{adminKey}}",
                "type": "text"
