          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Message is anonymized\", function () { pm.expect(pm.response.json().text).to.include(\"xxemail\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "9. Create prediction (saves C)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{adminKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/predictions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "predictions"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Manual test from Postman, contact bob@example.com\",\n  \"predicted_label\": \"spam\",\n  \"spam_probability\": 0.9,\n  \"threshold\": 0.5,\n  \"model_name\": \"postman-test\",\n  \"model_version\": \"0\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Text is anonymized\", function () { pm.expect(pm.response.json().text).to.not.include(\"bob@example.com\"); });",
                  "pm.collectionVariables.set(\"C\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "10. Replace prediction C",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{adminKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/predictions/{{C}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "predictions",
                "{{C}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Manual test from Postman, contact bob@example.com\",\n  \"predicted_label\": \"not_spam\",\n  \"spam_probability\": 0.2,\n  \"threshold\": 0.5,\n  \"model_name\": \"postman-test\",\n  \"model_version\": \"0\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Label is updated\", function () { pm.expect(pm.response.json().predicted_label).to.eql(\"not_spam\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
