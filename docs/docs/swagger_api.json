{
  "openapi": "3.1.0",
  "info": {
    "title": "IMAP Spam Detection API",
    "description": "\nSpam detection and text summarization service of the Intelligent Message Analysis Platform\n(IMAP).\n\n* **Prediction**: classify one or several messages as `spam` or `not_spam`, with the\n  probability of each label, and get a short summary of each message.\n* **Feedback**: report the correct label of a prediction, to monitor and retrain the model.\n* **Model**: consult the version and the evaluation metrics of the model in production.\n\n### Typical flow\n\n1. `POST /predict` with the messages. Keep the `prediction_id` of each result.\n2. If a label is wrong, `POST /feedback` with that `prediction_id` and the correct label.\n\n### Limits\n\n* 1 to 100 messages per request.\n* 1 to 10,000 characters per message, with at least one non-whitespace character.\n* Optional `threshold` between 0.0 and 1.0.\n\n### Summarization\n\nEach summary is generated by Google Gemini. If Gemini is unavailable or returns an unusable\nsummary, the configured cloud summarization service is used instead. The query parameter\n`cloud=true` skips Gemini. Classification succeeds even if both services fail; the `summary`\nis then `null`.\n\n### Privacy\n\nEmail addresses and phone numbers are anonymized before classification and storage. The\n**original message** is sent to the summarization providers. Do not submit sensitive data.\nAuthentication and rate limiting are not enforced.\n\n### Errors\n\nEvery error response has the body `{\"detail\": ...}`. Validation errors (422) list each\ninvalid field in `detail`.\n",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
          "General"
        ],
        "summary": "Welcome message",
        "description": "Return a welcome message with the name and the version of the API.",
        "operationId": "root",
        "responses": {
          "200": {
            "description": "Name and version of the API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RootResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "General"
        ],
        "summary": "Health check",
        "description": "Report whether the service is running and which model it serves.\n\nThe service is running whenever this endpoint answers. `model_loaded` tells whether\npredictions can be served.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Status of the service and of the loaded model",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/model": {
      "get": {
        "tags": [
          "Model"
        ],
        "summary": "Production model metadata",
        "description": "Return the metadata of the model in production.\n\nThe response includes the registered name, alias and version of the model, the MLflow run\nthat produced it, and the cross-validation and test metrics recorded in that run.",
        "operationId": "model_info",
        "responses": {
          "200": {
            "description": "Name, version, MLflow run and metrics of the model",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelInfoResponse"
                }
              }
            }
          },
          "503": {
            "description": "Production model not loaded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/predict": {
      "post": {
        "tags": [
          "Prediction"
        ],
        "summary": "Classify and summarize messages",
        "description": "Classify one or several messages as `spam` or `not_spam` and generate their summaries.\n\nA message is labelled `spam` when its spam probability is greater than or equal to\n`threshold`. `confidence` is the probability of the returned label and `spam_probability`\nthe probability of spam, whatever the threshold. Results keep the order of `texts`.\n\nEach result has a `prediction_id`: send it to `/feedback` to correct the label. A failed\nsummary does not fail the request; its `summary` is `null`.",
        "operationId": "predict",
        "parameters": [
          {
            "name": "cloud",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Skip Gemini and use the cloud summarization service directly.",
              "default": false,
              "title": "Cloud"
            },
            "description": "Skip Gemini and use the cloud summarization service directly."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One prediction per message, in the order of the request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid value detected while processing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Production model or prediction storage not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/feedback": {
      "post": {
        "tags": [
          "Feedback"
        ],
        "summary": "Correct a prediction",
        "description": "Store the label that the user considers correct for a prediction.\n\nThe prediction is identified by the `prediction_id` returned by `/predict`. Each prediction\naccepts one correction. The feedback is stored with a UTC timestamp and, together with the\nstored prediction, is used to monitor and retrain the model.",
        "operationId": "feedback",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Feedback stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackResponse"
                }
              }
            }
          },
          "404": {
            "description": "The prediction does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The prediction already has feedback",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Prediction storage not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Human-readable description of the error."
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "description": "Error returned by the API when a request cannot be served.",
        "examples": [
          {
            "detail": "Model not loaded"
          }
        ]
      },
      "FeedbackRequest": {
        "properties": {
          "prediction_id": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Prediction Id",
            "description": "Identifier returned by /predict."
          },
          "corrected_label": {
            "type": "string",
            "enum": [
              "spam",
              "not_spam"
            ],
            "title": "Corrected Label",
            "description": "Label that the user considers correct."
          }
        },
        "type": "object",
        "required": [
          "prediction_id",
          "corrected_label"
        ],
        "title": "FeedbackRequest",
        "description": "User correction of a prediction.",
        "examples": [
          {
            "corrected_label": "not_spam",
            "prediction_id": 1
          }
        ]
      },
      "FeedbackResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "Identifier of the stored feedback entry."
          },
          "prediction_id": {
            "type": "integer",
            "title": "Prediction Id",
            "description": "Prediction that the feedback corrects."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "UTC timestamp of the feedback."
          },
          "predicted_label": {
            "type": "string",
            "enum": [
              "spam",
              "not_spam"
            ],
            "title": "Predicted Label",
            "description": "Label returned by the model."
          },
          "corrected_label": {
            "type": "string",
            "enum": [
              "spam",
              "not_spam"
            ],
            "title": "Corrected Label",
            "description": "Label that the user considers correct."
          },
          "model_version": {
            "type": "string",
            "title": "Model Version",
            "description": "Version of the model that made the prediction."
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Confirmation message."
          }
        },
        "type": "object",
        "required": [
          "id",
          "prediction_id",
          "created_at",
          "predicted_label",
          "corrected_label",
          "model_version",
          "message"
        ],
        "title": "FeedbackResponse",
        "description": "Confirmation of a stored feedback entry.",
        "examples": [
          {
            "corrected_label": "not_spam",
            "created_at": "2026-11-10T10:00:00+00:00",
            "id": 1,
            "message": "Feedback stored",
            "model_version": "1",
            "predicted_label": "spam",
            "prediction_id": 1
          }
        ]
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "description": "Always `ok` when the service answers."
          },
          "model_loaded": {
            "type": "boolean",
            "title": "Model Loaded",
            "description": "Whether predictions can be served."
          },
          "model_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Name",
            "description": "Name of the loaded model, if any."
          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Version",
            "description": "Version of the loaded model, if any."
          }
        },
        "type": "object",
        "required": [
          "status",
          "model_loaded",
          "model_name",
          "model_version"
        ],
        "title": "HealthResponse",
        "description": "Status of the service and of the loaded model.",
        "examples": [
          {
            "model_loaded": true,
            "model_name": "spam-classifier",
            "model_version": "1",
            "status": "ok"
          }
        ]
      },
      "ModelInfoResponse": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Name of the model in the MLflow Model Registry."
          },
          "alias": {
            "type": "string",
            "title": "Alias",
            "description": "Alias through which the model was loaded."
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Registered model version."
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id",
            "description": "MLflow run that produced the model."
          },
          "metrics": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Metrics",
            "description": "Cross-validation and test metrics."
          }
        },
        "type": "object",
        "required": [
          "name",
          "alias",
          "version",
          "run_id",
          "metrics"
        ],
        "title": "ModelInfoResponse",
        "description": "Metadata of the production model.",
        "examples": [
          {
            "alias": "production",
            "metrics": {
              "cv_f1_macro": 0.97,
              "test_f1_macro": 0.96
            },
            "name": "spam-classifier",
            "run_id": "3f2b9c1d8e7a4b6c9d0e1f2a3b4c5d6e",
            "version": "1"
          }
        ]
      },
      "PredictionRequest": {
        "properties": {
          "texts": {
            "items": {
              "type": "string",
              "maxLength": 10000,
              "minLength": 1,
              "description": "Raw message to classify."
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Texts",
            "description": "Messages to classify, between 1 and 100 per request."
          },
          "threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Threshold",
            "description": "Spam probability from which a message is labelled as spam. A higher value produces fewer false positives and more false negatives.",
            "default": 0.5
          }
        },
        "type": "object",
        "required": [
          "texts"
        ],
        "title": "PredictionRequest",
        "description": "One or several messages to classify.",
        "examples": [
          {
            "texts": [
              "Congratulations! You won a FREE iPhone. Claim it at http://win.example",
              "Hi team, the meeting has been moved to 3pm. Write to ana@example.com"
            ],
            "threshold": 0.5
          }
        ]
      },
      "PredictionResponse": {
        "properties": {
          "model_name": {
            "type": "string",
            "title": "Model Name",
            "description": "Name of the model that made the predictions."
          },
          "model_version": {
            "type": "string",
            "title": "Model Version",
            "description": "Version of the model that made the predictions."
          },
          "threshold": {
            "type": "number",
            "title": "Threshold",
            "description": "Spam threshold applied to the batch."
          },
          "predictions": {
            "items": {
              "$ref": "#/components/schemas/PredictionResult"
            },
            "type": "array",
            "title": "Predictions",
            "description": "One result per message, in the order of the request."
          }
        },
        "type": "object",
        "required": [
          "model_name",
          "model_version",
          "threshold",
          "predictions"
        ],
        "title": "PredictionResponse",
        "description": "Predictions for a batch of messages, in the order of the request.",
        "examples": [
          {
            "model_name": "spam-classifier",
            "model_version": "1",
            "predictions": [
              {
                "confidence": 0.98,
                "label": "spam",
                "prediction_id": 1,
                "spam_probability": 0.98,
                "summary": "A message claims the recipient won a free phone."
              },
              {
                "confidence": 0.97,
                "label": "not_spam",
                "prediction_id": 2,
                "spam_probability": 0.03,
                "summary": "The team meeting has been moved to 3pm."
              }
            ],
            "threshold": 0.5
          }
        ]
      },
      "PredictionResult": {
        "properties": {
          "prediction_id": {
            "type": "integer",
            "title": "Prediction Id",
            "description": "Identifier to send with /feedback."
          },
          "label": {
            "type": "string",
            "enum": [
              "spam",
              "not_spam"
            ],
            "title": "Label",
            "description": "Predicted label."
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "description": "Probability of the predicted label."
          },
          "spam_probability": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Spam Probability",
            "description": "Probability of spam."
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary",
            "description": "Generated summary of the original message."
          }
        },
        "type": "object",
        "required": [
          "prediction_id",
          "label",
          "confidence",
          "spam_probability"
        ],
        "title": "PredictionResult",
        "description": "Prediction for one message."
      },
      "RootResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Welcome message with a pointer to the documentation."
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Name of the API."
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Version of the API."
          }
        },
        "type": "object",
        "required": [
          "message",
          "name",
          "version"
        ],
        "title": "RootResponse",
        "description": "Welcome message of the API.",
        "examples": [
          {
            "message": "Welcome to the IMAP Spam Detection API. See /docs for the documentation.",
            "name": "IMAP Spam Detection API",
            "version": "1.0.0"
          }
        ]
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "tags": [
    {
      "name": "General",
      "description": "Service information and health check."
    },
    {
      "name": "Model",
      "description": "Metadata of the model in production."
    },
    {
      "name": "Prediction",
      "description": "Spam classification of messages."
    },
    {
      "name": "Feedback",
      "description": "Collection of user corrections."
    }
  ],
  "servers": [
    {
      "url": "https://datatouille-api.onrender.com",
      "description": "Public deployment"
    },
    {
      "url": "http://localhost:8000",
      "description": "Local server (uvicorn src.api.api:app)"
    }
  ]
}
