MLFLOW_TRACKING_URI=https://dagshub.com/Tostaza/MLOps-Datatouille.mlflow
MLFLOW_TRACKING_USERNAME=<user>
MLFLOW_TRACKING_PASSWORD=<password>

# API: registered model served and its alias (defaults shown)
MLFLOW_MODEL_NAME=spam-classifier
MLFLOW_MODEL_ALIAS=production
# API: SQLite file of predictions and feedback (optional, defaults to data/api/predictions.db)
# PREDICTIONS_DB_PATH=/absolute/path/to/predictions.db

# Optional: add your Gemini API key to .env to enable Gemini summaries.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional fallback endpoint; required for cloud=true or Gemini fallback.
CLOUD_SUMMARIZATION_URL=